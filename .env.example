# ElevenLabs - required for synthesizing audio in the playground (local only)
ELEVENLABS_API_KEY=

# Default voice id used when a take does not specify one (Rachel - clear, natural)
VOICES_DEFAULT_ID=21m00Tcm4TlvDq8ikWAM

# Optional bearer token required by writing routes (POST/DELETE) from non-localhost
# callers. Leave empty to allow local/LAN use without a token.
VOICES_TOKEN=

# Optional: canonical site URL for OpenGraph/metadata
NEXT_PUBLIC_SITE_URL=https://voices-bheng.vercel.app

# Stickies (minted per-app by /onboard; leave blank in the template)
STICKIES_API_BASE=http://localhost:4444
STICKIES_TOKEN=
